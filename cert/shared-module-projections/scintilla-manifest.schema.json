{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintilla.run/schemas/module-projections-manifest-v1.schema.json",
  "title": "Scintilla module projection manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generator", "rules", "languages"],
  "properties": {
    "version": { "const": "scintilla.module-projections/v1" },
    "generator": { "$ref": "#/$defs/generator" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefer_native_module_contract",
        "fallback_export_value_must_be_typed",
        "projection_must_preserve_invocation_semantics",
        "projection_does_not_define_transport_schema"
      ],
      "properties": {
        "prefer_native_module_contract": { "const": true },
        "fallback_export_value_must_be_typed": { "const": true },
        "projection_must_preserve_invocation_semantics": { "const": true },
        "projection_does_not_define_transport_schema": { "const": true }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/language_projection" }
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "rust_api",
        "runtime_profile",
        "generated_files_read_only",
        "commit"
      ],
      "properties": {
        "repository": { "const": "ORESoftware/api-docs" },
        "rust_api": { "const": "render_module_interface" },
        "runtime_profile": { "const": "scintilla" },
        "generated_files_read_only": { "const": true },
        "commit": { "const": "c02712957850046e339b1e94d8d41b219feb304c" }
      }
    },
    "language_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "strategy", "enforcement"],
      "properties": {
        "id": {
          "enum": [
            "rust", "typescript", "dart", "gleam", "erlang", "sml", "ocaml",
            "racket", "ada", "modula2", "modula3", "haskell", "wit"
          ]
        },
        "strategy": {
          "enum": [
            "trait_impl",
            "satisfies_export_object",
            "abstract_interface_or_typed_export",
            "opaque_typed_export",
            "behaviour_callbacks",
            "signature_structure",
            "module_type",
            "provide_contract",
            "package_spec",
            "definition_module",
            "interface_module",
            "backpack_signature",
            "component_interface"
          ]
        },
        "enforcement": {
          "enum": [
            "compile_time",
            "compiler_plus_static_analysis",
            "runtime_boundary",
            "component_link_time"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      },
      "oneOf": [
        { "required": ["source"] },
        { "required": ["example"] }
      ]
    }
  }
}
