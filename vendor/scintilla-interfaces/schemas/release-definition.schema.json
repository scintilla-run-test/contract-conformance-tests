{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintilla.run/schemas/release-definition.v1.json",
  "title": "Scintilla immutable release definition",
  "description": "Pins one request-consistent deployment release across middleware generations and function revisions. Middleware implementation language and placement are intentionally independent. Rollout status and gates are mutable release state and are not part of this content-addressed definition.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "deploymentKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]{0,119}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "runtime": {
      "enum": ["nodejs", "python3", "ruby", "bash", "golang", "dart", "erlang", "elixir", "java", "gleam", "rust", "browser"]
    },
    "middlewareRuntime": {
      "enum": ["rust", "erlang", "gleam", "wasm", "container"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "provider"],
      "properties": {
        "scope": {
          "enum": ["edge", "host", "sidecar", "external", "local"]
        },
        "provider": { "$ref": "#/$defs/provider" },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "middlewareStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "placement", "runtime", "artifactSha256", "protocol"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "role": {
          "enum": ["edge", "platform", "application"]
        },
        "placement": { "$ref": "#/$defs/placement" },
        "runtime": { "$ref": "#/$defs/middlewareRuntime" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocol": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          }
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "functionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "functionId", "revision", "artifactSha256", "runtime", "carrier", "execution"],
      "properties": {
        "targetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "functionId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "policySha256": {
          "$ref": "#/$defs/sha256",
          "description": "Optional admitted resource/capability policy digest. New deployment-doc producers require this field; omission remains accepted for backward compatibility."
        },
        "runtime": { "$ref": "#/$defs/runtime" },
        "carrier": {
          "enum": ["http_ingress", "direct_invoke"]
        },
        "execution": {
          "enum": ["process", "container"]
        },
        "operationKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "deploymentKey", "releaseId", "source", "routeTableSha256", "apiContractSha256", "middleware", "functions"],
  "properties": {
    "apiVersion": { "const": "scintilla.run/v1" },
    "deploymentKey": { "$ref": "#/$defs/deploymentKey" },
    "releaseId": { "$ref": "#/$defs/releaseId" },
    "source": { "$ref": "#/$defs/source" },
    "routeTableSha256": { "$ref": "#/$defs/sha256" },
    "apiContractSha256": {
      "$ref": "#/$defs/sha256",
      "description": "Digest of the normalized API/docs contract for this release. Deliberately distinct from routeTableSha256 so routing identity and public contract identity cannot be conflated."
    },
    "middleware": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/middlewareStage" }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/functionTarget" }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
